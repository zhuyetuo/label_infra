# docker compose 用的变量文件，复制成 .env 后修改
# 用法：cd smart-label/deploy && cp env/.env.example env/.env && docker compose up -d

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=smart_label
MYSQL_USER=smart_label
MYSQL_PASSWORD=CHANGE_ME

# NAS 在宿主机上的真实路径，挂载进容器（容器内路径与 NAS_ROOT 保持一致，不用改代码）
NAS_ROOT_HOST=/home/toky/ai_data
NAS_ROOT=/home/toky/ai_data

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
BACKEND_PORT=8283

# imu_train/label_service AI 服务地址（容器内访问宿主机要用内网 IP，不能写 localhost）
ALGO_SERVICE_URL=http://192.168.2.140:8383

# vision_service（SAM 辅助标注，imu_train/vision_service，端口 8385）。
# 留空 = 关着：视觉标注页上「SAM 点选」按钮置灰，画框、导出、推牙位一概不受影响。
# 要开：先在带 GPU 的机器上按 imu_train/vision_service/README.md 起服务，
# 再把地址填这里（跟 ALGO_SERVICE_URL 是两个服务、两个端口，别填成同一个）。
VISION_SERVICE_URL=

# 算法任务素材库 NAS（牙齿/口腔照片在 口腔验证/ 下），宿主机挂载点；容器内同路径
MATERIAL_ROOT_HOST=/home/toky/alg_material
MATERIAL_ROOT=/home/toky/alg_material

# 容器时区，跟宿主机保持一致（日志/数据库时间/定时任务都按它）
TZ=Asia/Shanghai
