# docker compose 用的变量文件，复制成 .env 后修改
# 用法：cd smart-label/deploy && cp env/.env.example env/.env && docker compose up -d

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=smart_label
MYSQL_USER=smart_label
MYSQL_PASSWORD=CHANGE_ME

# NAS 在宿主机上的真实路径，挂载进容器（容器内路径与 NAS_ROOT 保持一致，不用改代码）
NAS_ROOT_HOST=/home/toky/ai_data
NAS_ROOT=/home/toky/ai_data

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
BACKEND_PORT=8283

# imu_train/label_service AI 服务地址（容器内访问宿主机要用内网 IP，不能写 localhost）
ALGO_SERVICE_URL=http://192.168.2.140:8383

# vision_service（SAM 辅助标注，imu_train/vision_service，端口 8385）。
#
# 留空就走 docker-compose.yml 里的默认值 http://192.168.2.140:8385——也就是
# 「服务起着就能用，不用在这儿填」。服务没起时按钮照样置灰、并说明连不上，
# 画框、导出、推牙位一概不受影响。
#
# 只有地址不是默认那个才需要填（跟 ALGO_SERVICE_URL 是两个服务、两个端口，
# 别填成同一个）。要显式关掉 SAM：填 off。
VISION_SERVICE_URL=
# 建画面索引时几路视频一起送视觉服务（默认 8）。
# **跟算法服务的 DECODE_CPU_SHARE 配套**：默认 0（全走 NVDEC）配并发 8；
# 要是把 DECODE_CPU_SHARE 设成 0.5（一半走 CPU 软解），这个数要提到 12，
# 否则走硬解的路反而比现在少。只改一边必然更差
VISION_INDEX_CONCURRENCY=

# algo_tinyml/edge_service（端侧推理，端口 8900）。跑的是烧进项圈的那份 C，
# 用来在模型对比里回答"这个模型上板之后会是什么效果"。
#
# 跟 VISION_SERVICE_URL 一样，**留空就是用默认地址**（8900 端口），
# 「服务起着就能用，不用在这儿填」。服务没起时版本下拉里那一组是空的、
# 旁边给个小提示，模型对比的其它功能一概不受影响。
#
# 只有地址不是默认那个才需要填。要显式关掉：填 off。
#
# 有哪些端侧模型不在这儿配——问服务自己（GET /model-eval/edge-models）。
# 配置跟服务不同步的话，界面上会出现一个选了就报错的选项。
EDGE_SERVICE_URL=

# 算法任务素材库 NAS（牙齿/口腔照片在 口腔验证/ 下），宿主机挂载点；容器内同路径
MATERIAL_ROOT_HOST=/home/toky/alg_material
MATERIAL_ROOT=/home/toky/alg_material

# 容器时区，跟宿主机保持一致（日志/数据库时间/定时任务都按它）
TZ=Asia/Shanghai
