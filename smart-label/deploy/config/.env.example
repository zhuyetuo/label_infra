# docker compose 用的变量文件，复制成 .env 后修改
# 用法：cd smart-label/deploy && cp env/.env.example env/.env && docker compose up -d

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=smart_label
MYSQL_USER=smart_label
MYSQL_PASSWORD=CHANGE_ME

# NAS 在宿主机上的真实路径，挂载进容器（容器内路径与 NAS_ROOT 保持一致，不用改代码）
NAS_ROOT_HOST=/home/toky/ai_data
NAS_ROOT=/home/toky/ai_data

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
BACKEND_PORT=8283
